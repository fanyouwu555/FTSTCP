<Window x:Class="FTSTCP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FTSTCP.App.ViewModels"
        mc:Ignorable="d"
        Title="FTSTCP - 局域网大文件并行传输工具" Height="650" Width="900"
        Background="#F5F5F7">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 服务器设置 -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="本地服务器 (接收端)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="本机 IP: " VerticalAlignment="Center" Width="60"/>
                        <TextBox Text="{Binding ServerIp, Mode=OneWay}" IsReadOnly="True" Width="120" Padding="5"/>
                        <TextBlock Text="端口: " VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBox Text="{Binding ServerPort}" Width="60" Padding="5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="启动服务器" Command="{Binding StartServerCommand}" Width="100" Padding="8" Background="#007AFF" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="停止服务器" Command="{Binding StopServerCommand}" Width="100" Margin="10,0,0,0" Padding="8" Background="#FF3B30" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Ellipse Width="12" Height="12" Margin="15,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF3B30"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Fill" Value="#34C759"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 客户端设置 -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="远程客户端" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#333"/>
                        
                        <TextBlock Text="目标地址" Foreground="#666" FontSize="11" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox Text="{Binding TargetIp}" Width="120" Padding="5" VerticalContentAlignment="Center"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding TargetPort}" Width="60" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="核心配置" Foreground="#666" FontSize="11" Margin="0,0,10,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="任务并发数:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666"/>
                            <TextBox Text="{Binding MaxParallel}" Width="50" Padding="5" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Button Content="发送本地文件..." Command="{Binding SendFileCommand}" Width="150" Padding="8" HorizontalAlignment="Left" Background="#5856D6" Foreground="White" BorderThickness="0" Margin="0,0,0,15">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Separator Background="#EEE" Margin="0,0,0,15"/>

                        <TextBlock Text="请求远程下载" Foreground="#666" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RemotePath}" Padding="5" Margin="0,0,0,10" Tag="远程文件路径" ToolTip="输入远程服务器上的文件路径"/>
                        <Button Content="从服务器下载" Command="{Binding DownloadFileCommand}" Width="150" Padding="8" HorizontalAlignment="Left" Background="#007AFF" Foreground="White" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 传输列表 -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="传输任务" FontWeight="Bold" Margin="5,5,5,10" Foreground="#666"/>
                    <Button Grid.Column="1" Content="清理已完成" Command="{Binding ClearCompletedCommand}" Padding="10,2" Margin="0,0,5,5" Background="Transparent" Foreground="#007AFF" BorderThickness="1" BorderBrush="#007AFF" FontSize="11">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding Transfers}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding FileName}" Width="200"/>
                            <GridViewColumn Header="方向" DisplayMemberBinding="{Binding Direction}" Width="60"/>
                            <GridViewColumn Header="进度" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="230">
                                            <ProgressBar Value="{Binding Progress}" Height="15" Foreground="#007AFF" Background="#E5E5EA" BorderThickness="0"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0:F1}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="#333"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="速度" DisplayMemberBinding="{Binding Speed}" Width="100"/>
                            <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="80"/>
                            <GridViewColumn Header="已用时间" DisplayMemberBinding="{Binding Duration}" Width="100"/>
                            <GridViewColumn Header="剩余时间" DisplayMemberBinding="{Binding RemainingTime}" Width="100"/>
                            <GridViewColumn Header="操作" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="取消" Command="{Binding CancelCommand}" Padding="5,2" Background="#FF3B30" Foreground="White" BorderThickness="0" FontSize="11">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="2" Background="#1C1C1E" CornerRadius="10" Margin="0,20,0,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="控制台日志" Foreground="#8E8E93" FontWeight="Bold" Margin="0,0,0,10" FontSize="11"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding LogText}" Foreground="#34C759" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
